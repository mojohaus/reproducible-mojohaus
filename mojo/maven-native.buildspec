groupId=org.codehaus.mojo
artifactId=maven-native
centralLink=https://repo.maven.apache.org/maven2/org/codehaus/mojo/native-maven-plugin

gitRepo=https://github.com/mojohaus/${artifactId}.git

jdk=7
newline=lf

command="mvn -Pmojo-release clean package -DskipTests -Dmaven.javadoc.skip -Dgpg.skip"
buildinfo=native-maven-plugin/target/native-maven-plugin-*.buildinfo
